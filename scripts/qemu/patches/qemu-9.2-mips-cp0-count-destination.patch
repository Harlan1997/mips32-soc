+    __attribute__((weak));
+
+target_ulong helper_mfc0_count(CPUMIPSState *env, uint32_t rt,
+                               uint32_t guest_pc)
 {
+    if (qemu_mips32_soc_ref_cp0_retire_ticks_rt) {
+        return (int32_t)qemu_mips32_soc_ref_cp0_retire_ticks_rt(env, rt,
+                                                                  guest_pc);
+    }
     return (int32_t)cpu_mips_get_count(env);
 }
