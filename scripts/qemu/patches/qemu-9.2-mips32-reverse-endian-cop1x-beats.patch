diff --git a/target/mips/internal.h b/target/mips/internal.h
--- a/target/mips/internal.h
+++ b/target/mips/internal.h
@@ -316,6 +316,14 @@
         env->hflags |= (env->CP0_Status >> CP0St_KSU) &
                        MIPS_HFLAG_KSU;
     }
+    /* SOC_REF_RE_COP1X: the project RTL applies Status.RE only in user
+     * mode, and exception/error level always returns to native ordering. */
+    if (!(env->CP0_Status & (1 << CP0St_EXL)) &&
+        !(env->CP0_Status & (1 << CP0St_ERL)) &&
+        ((env->hflags & MIPS_HFLAG_KSU) == MIPS_HFLAG_UM) &&
+        (env->CP0_Status & (1 << CP0St_RE))) {
+        env->hflags |= MIPS_HFLAG_RE;
+    }
 #if defined(TARGET_MIPS64)
     if ((env->insn_flags & ISA_MIPS3) &&
         (((env->hflags & MIPS_HFLAG_KSU) != MIPS_HFLAG_UM) ||
