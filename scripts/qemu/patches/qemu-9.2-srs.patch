diff --git a/target/mips/tcg/sysemu/special_helper.c b/target/mips/tcg/sysemu/special_helper.c
--- a/target/mips/tcg/sysemu/special_helper.c
+++ b/target/mips/tcg/sysemu/special_helper.c
@@ -45,6 +45,20 @@ target_ulong helper_ei(CPUMIPSState *env)
     return t0;
 }
+
+target_ulong helper_rdpgpr(CPUMIPSState *env, uint32_t reg)
+{
+    uint32_t pss = extract32(env->CP0_SRSCtl, CP0SRSCtl_PSS, 4);
+
+    return pss < 16 && reg < 32 ? env->active_tc.srs_gpr[pss][reg] : 0;
+}
+
+void helper_wrpgpr(CPUMIPSState *env, target_ulong value, uint32_t reg)
+{
+    uint32_t pss = extract32(env->CP0_SRSCtl, CP0SRSCtl_PSS, 4);
+
+    if (pss < 16 && reg != 0 && reg < 32) {
+        env->active_tc.srs_gpr[pss][reg] = value;
+    }
+}
diff --git a/target/mips/tcg/translate.c b/target/mips/tcg/translate.c
--- a/target/mips/tcg/translate.c
+++ b/target/mips/tcg/translate.c
@@ -1231,42 +1231,16 @@ static inline void gen_load_srsgpr(int from, int to)
 static inline void gen_load_srsgpr(int from, int to)
 {
     TCGv t0 = tcg_temp_new();
+    gen_helper_rdpgpr(t0, tcg_env, tcg_constant_i32(from));
     gen_store_gpr(t0, to);
 }
 
 static inline void gen_store_srsgpr(int from, int to)
 {
+    TCGv t0 = tcg_temp_new();
+    gen_load_gpr(t0, from);
+    gen_helper_wrpgpr(tcg_env, t0, tcg_constant_i32(to));
 }
