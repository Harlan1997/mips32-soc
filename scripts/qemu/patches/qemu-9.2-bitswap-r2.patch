diff --git a/target/mips/tcg/translate.c b/target/mips/tcg/translate.c
--- a/target/mips/tcg/translate.c
+++ b/target/mips/tcg/translate.c
@@ -14202,10 +14202,14 @@ static void decode_opc_special3(CPUMIPSState *env, DisasContext *ctx)
         case OPC_ALIGN_1:
         case OPC_ALIGN_2:
         case OPC_ALIGN_3:
-        case OPC_BITSWAP:
-            check_insn(ctx, ISA_MIPS_R6);
-            decode_opc_special3_r6(env, ctx);
+            check_insn(ctx, ISA_MIPS_R2); /* SOC_REF_ALIGN_R2 */
