// Formal property scaffold for AXI SRAM response channels.
`ifdef FORMAL_ENABLE
module axi_sram_invariant_props (
    input logic        clk,
    input logic        rst_n,
    input logic        s_rvalid,
    input logic        s_rready,
    input logic [3:0]  s_rid,
    input logic [31:0] s_rdata,
    input logic [1:0]  s_rresp,
    input logic        s_rlast,
    input logic        s_bvalid,
    input logic        s_bready,
    input logic [3:0]  s_bid,
    input logic [1:0]  s_bresp
);
    default clocking cb @(posedge clk); endclocking
    default disable iff (!rst_n);

    property p_read_stable_under_backpressure;
        (s_rvalid && !s_rready) |=> (s_rvalid && $stable({s_rid, s_rdata,
            s_rresp, s_rlast}));
    endproperty
    AXI_SRAM_R_STABLE: assert property (p_read_stable_under_backpressure)
        else $error("axi_sram: R channel changed while stalled");

    property p_write_response_stable_under_backpressure;
        (s_bvalid && !s_bready) |=> (s_bvalid && $stable({s_bid, s_bresp}));
    endproperty
    AXI_SRAM_B_STABLE: assert property (p_write_response_stable_under_backpressure)
        else $error("axi_sram: B channel changed while stalled");
endmodule
`endif
