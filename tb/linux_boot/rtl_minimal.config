# Minimal single-core profile for the RTL SoC Linux userspace gate.
# Keep MM, scheduler, signals, initramfs and the 8250 console enabled.  These
# options remove unrelated platform/device initcalls which have no model in
# the vendor-neutral RTL SoC and can otherwise delay kernel_init indefinitely.
CONFIG_MODULES
CONFIG_NET
CONFIG_BPF_SYSCALL
CONFIG_PCI
CONFIG_SCSI
CONFIG_USB_SUPPORT
CONFIG_SOUND
CONFIG_DRM
CONFIG_WLAN
CONFIG_WIRELESS
CONFIG_NFS_FS
CONFIG_EXT4_FS
CONFIG_MTD
CONFIG_ATA
CONFIG_INPUT
CONFIG_HID
CONFIG_I2C
CONFIG_SPI
CONFIG_CAN
CONFIG_FIREWIRE
CONFIG_INFINIBAND
CONFIG_BT
CONFIG_WWAN
CONFIG_VIRTUALIZATION
CONFIG_KVM
CONFIG_MIPS_CPS
CONFIG_MIPS_CPS_NS
CONFIG_MIPS_CPS_MP
CONFIG_MIPS_MT_SMP
CONFIG_SMP
