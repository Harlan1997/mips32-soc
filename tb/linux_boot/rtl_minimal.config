# Minimal single-core profile for the RTL SoC Linux userspace gate.
# Keep MM, scheduler, signals, initramfs and the 8250 console enabled.  These
# options remove unrelated platform/device initcalls which have no model in
# the vendor-neutral RTL SoC and can otherwise delay kernel_init indefinitely.
# The RTL APB model currently rejects Linux's devtmpfs mount mode before
# userspace. The initramfs supplies the console node for this diagnostic
# profile, so disable devtmpfs and its automount to isolate later boot stages.
# Generic remains unchanged and still requires the normal device filesystem.
CONFIG_DEVTMPFS
CONFIG_DEVTMPFS_MOUNT
# No modeled block device, PPS source, FUSE filesystem, or block I/O queue
# exists in the RTL SoC image; remove their initcalls from this opt-in profile.
CONFIG_PPS
CONFIG_FUSE_FS
CONFIG_BLOCK
CONFIG_BLK_DEV
CONFIG_MQ_IOSCHED_DEADLINE
CONFIG_MQ_IOSCHED_KYBER
CONFIG_IOSCHED_BFQ
CONFIG_MODULES
CONFIG_NET
CONFIG_BPF_SYSCALL
CONFIG_PCI
CONFIG_SCSI
CONFIG_USB_SUPPORT
CONFIG_SOUND
CONFIG_DRM
CONFIG_WLAN
CONFIG_WIRELESS
CONFIG_NFS_FS
CONFIG_EXT4_FS
CONFIG_MTD
CONFIG_ATA
CONFIG_INPUT
CONFIG_HID
CONFIG_I2C
CONFIG_SPI
CONFIG_CAN
CONFIG_FIREWIRE
CONFIG_INFINIBAND
CONFIG_BT
CONFIG_WWAN
CONFIG_VIRTUALIZATION
CONFIG_KVM
CONFIG_MIPS_CPS
CONFIG_MIPS_CPS_NS
CONFIG_MIPS_CPS_MP
CONFIG_MIPS_MT_SMP
CONFIG_SMP
