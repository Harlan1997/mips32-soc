// SPDX-License-Identifier: GPL-2.0-or-later
/dts-v1/;

/ {
	#address-cells = <1>;
	#size-cells = <1>;
	compatible = "harlan,mips32-soc-ref";

	aliases { serial0 = &uart0; };
	chosen {
		bootargs = "console=ttyS0,115200 earlycon=uart8250,mmio32,0x40000000 lpj=624128 rdinit=/init";
		stdout-path = "serial0:115200n8";
	};
	/* The RTL image reserves the first 8 MiB of its DDR backing store for the
	 * low-physical-address alias path and places the kernel at 0x08800000.
	 * This is an RTL-only layout; QEMU keeps its independent RAM-at-zero DTS. */
	memory@8000000 { device_type = "memory"; reg = <0x08000000 0x02000000>; };

	cpus {
		#address-cells = <1>;
		#size-cells = <0>;
		cpu@0 {
			compatible = "mips,mips24Kc";
			device_type = "cpu";
			reg = <0>;
			clocks = <&cpu_clk>;
		};
	};
	cpu_clk: cpu-clock {
		compatible = "fixed-clock";
		#clock-cells = <0>;
		clock-frequency = <50000000>;
	};
	cpuintc: interrupt-controller {
		#address-cells = <0>;
		#interrupt-cells = <1>;
		interrupt-controller;
		compatible = "mti,cpu-interrupt-controller";
	};
	uart0: serial@40000000 {
		compatible = "ns16550a";
		interrupt-parent = <&cpuintc>;
		/* RTL Linux probe retains the legacy generic CPU IRQ ABI; the
		 * bare-metal RTL UART source is VIC source 1 -> CPU IP2. */
		interrupts = <4>;
		reg = <0x40000000 0x1000>;
		reg-shift = <2>;
		reg-io-width = <4>;
		clock-frequency = <50000000>;
		no-loopback-test;
		status = "okay";
	};
};
